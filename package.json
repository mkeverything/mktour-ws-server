{
  "name": "mktour-ws-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "1.0.0-rc.4",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "dev:local": "OFFLINE=true bun --watch index.ts",
    "format": "bunx prettier . --write",
    "typecheck": "tsc --noEmit",
    "db:pull": "drizzle-kit pull && rm -rf lib/db/migrations/*/ && prettier --write lib/db/migrations"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "lucia": "^3.2.2",
    "nanoid": "^6.0.1"
  }
}
